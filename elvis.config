% -*- mode: erlang; -*- vim: set ft=erlang:
[{elvis, [
    {config, [
        #{ dirs => ["src/**"],
           filter => "*.erl",
           ruleset => erl_files },
        #{ dirs => ["test/**"],
           filter => "*.erl",
           ruleset => erl_files,
           rules => [
                {elvis_style, function_naming_convention, disable},
                {elvis_text_style, line_length, disable}
           ] },
        #{ dirs => ["."],
           filter => "rebar.config",
           ruleset => rebar_config },
        #{ dirs => ["."],
           filter => "elvis.config",
           ruleset => elvis_config }
    ]},
    {verbose, false}
]}].
