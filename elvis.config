% -*- mode: erlang; -*- vim: set ft=erlang:
[
    {config, [
        #{
            files => ["src/**/*.erl"],
            ruleset => erl_files,
            % Internal worker functions use a trailing-underscore idiom
            % (e.g. config_, encode_list_): the validated public function wraps a
            % "_"-suffixed helper that assumes pre-validated arguments.
            rules => [
                {elvis_style, function_naming_convention, #{
                    regex => "^[a-z](_?[a-z0-9]+)*_?$"
                }}
            ]
        },
        #{
            files => ["test/**/*.erl"],
            ruleset => erl_files,
            % test/erlzord_tests.erl is machine-generated (see support/test_cases/)
            rules => [
                {elvis_style, function_naming_convention, disable},
                {elvis_text_style, max_line_length, disable}
            ]
        },
        #{
            files => ["rebar.config", "elvis.config"],
            ruleset => rebar_config
        }
    ]}
].
